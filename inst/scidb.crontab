# crontab copy

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# ---- [external db updates] ----

# ARGOS (every 3 hours)
0 */3       * * *  Rscript --default-packages=dup -e 'ARGOS.pipeline();'

# ARGOS2 (every hour)
0 */1       * * *  Rscript --default-packages=dup -e 'ARGOS2.pipeline();'


# RUFFatSEEWIESEN
# 0 18 * * *  Rscript --default-packages=dup -e 'RUFFatSEEWIESEN_photos.pipeline()'


#DRUID (every 12 hours)
0 */12 * * * Rscript --default-packages=dup -e  'DRUID_update()'

# KINEIS (every 5 hours)
# flock skips this run cleanly if another KINEIS update holds the lock.
0 */5 * * * /usr/bin/flock -n -E 0 /tmp/dup-kineis-update.lock /usr/bin/Rscript --default-packages=dup -e 'KINEIS_update()'


# ---- [Maintenance] ----

# replication
*/10 * * * *  Rscript --default-packages=dup -e 'check_replication("scidb", "scidb_maoraves")'

# backup
# 0 0        * * *    Rscript --default-packages=dup -e 'backup.pipeline()'     


# backup from field servers

# DUMMER

# 0 2 * * *  Rscript --default-packages=dup -e 'db_copy("FIELD_2025_NOLAatDUMMERSEE", "remotehost_1", "host")'     

#NZ
0 */1  * * *  Rscript --default-packages=dup -e 'db_copy("FIELD_2025_BADOatNZ", "remotehost_1", "host")'

# chick finder
0 */12  * * *  Rscript --default-packages=dup -e 'db_copy("dotterelFinder", "remotehost_1", "host")'



# DOCUWIKI BACKUP (TODO)
# 0 1        * * *    duplicity --no-encryption /media/DATA/WIKIS/html file:///ds/scidbbackup/dokuwiki_backups/duplicity/

# internal updates
3 22        * * *   Rscript --default-packages=dup -e 'DB_internal_updates.pipeline()'
